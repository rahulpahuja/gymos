rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in ['rahulpahuja2015@gmail.com', 'therahulpahuja@gmail.com'];
    }

    // Check if user is approved admin
    function isAdmin() {
      return isAuthenticated() &&
        (isOwnerEmail() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'));
    }

    // Check if user is approved (admin, manager, trainer, or trainee)
    function isApprovedUser() {
      return isAuthenticated() &&
        (isOwnerEmail() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'));
    }

    // Approved branch managers may review and approve staff (trainer / trainee) sign-ups
    function isApprovedManager() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function myBranchId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branchId;
    }

    // A manager may only touch records belonging to their own assigned branch
    // ('all' never matches a manager's own branchId, so branch-wide/global
    // records — e.g. an 'all'-scoped PT package — stay admin-only).
    function isManagerForBranch(branchId) {
      return isApprovedManager() && myBranchId() == branchId;
    }

    function canWriteBranchScoped(branchId) {
      return isAdmin() || isManagerForBranch(branchId);
    }

    // The gymos client re-syncs an ENTIRE local collection (every branch's
    // records) in one atomic batch on every local change — see
    // firestoreSync.ts pushCollection(). A per-document branch check alone
    // would reject that whole batch the instant it contains any other
    // branch's untouched record, breaking sync for every manager. Treating a
    // byte-for-byte-unchanged re-set as always allowed keeps that harmless
    // resync working while still blocking any *actual* cross-branch edit.
    function isNoOpWrite() {
      return request.resource.data == resource.data;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read user records (required for staff directory & approval checks)
      allow read: if isAuthenticated();

      // User can create their own profile on sign-up; admins & managers can pre-authorize profiles
      allow create: if isAuthenticated() && (isSelf(userId) || isAdmin() || isApprovedManager());

      // Admins & branch managers can approve/update profiles; users can update their own non-role fields
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isApprovedManager() ||
        (isSelf(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approvedBy', 'approvedAt'])))
      );

      // Admins can delete users
      allow delete: if isAdmin();
    }

    // Pre-authorized staff (keyed by lowercased email, before their real UID
    // exists). Admins/managers create these; consuming a match on sign-in
    // requires the signing-in user to read and then delete only their OWN
    // matching email doc — never anyone else's.
    match /preauthorized_staff/{email} {
      allow get, delete: if isAuthenticated() && request.auth.token.email.lower() == email;
      allow create, update: if isAdmin() || isApprovedManager();
      allow list: if isAdmin() || isApprovedManager();
    }

    // Branches Collection: readable by all authenticated users (required for
    // target branch dropdowns). Branch entities themselves are admin-only to
    // manage — the client's own branch-management UI is already admin-gated.
    match /branches/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isNoOpWrite();
      allow delete: if isAdmin();
    }

    // Operational collections: read stays open to any approved user (trainer/
    // trainee self-service portals are read-only and need this); writes are
    // admin-unrestricted, manager-restricted to their own branch's records.
    match /trainees/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /trainers/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /pt_packages/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.assignedBranchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.assignedBranchId) && canWriteBranchScoped(request.resource.data.assignedBranchId));
      allow delete: if canWriteBranchScoped(resource.data.assignedBranchId);
    }
    match /pt_subscriptions/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /pt_sessions/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /payments/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /pt_settlements/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /enquiries/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /expenses/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }
    match /equipment/{document=**} {
      allow read: if isApprovedUser();
      allow create: if canWriteBranchScoped(request.resource.data.branchId);
      allow update: if isNoOpWrite() || (canWriteBranchScoped(resource.data.branchId) && canWriteBranchScoped(request.resource.data.branchId));
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }

    // Attendance: create/update MUST stay open to every approved user (not
    // just admin/manager) — a live biometric punch is relayed to Firestore
    // from whichever session happens to have gymos open, including a
    // trainer/trainee self-service portal (see BiometricPunchToast.tsx).
    // There is no delete UI for attendance, so that alone is branch-scoped.
    match /attendance/{document=**} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser();
      allow delete: if canWriteBranchScoped(resource.data.branchId);
    }

    // Audit logs: a genuine append-only compliance ledger. Any approved
    // user's session can append an entry (their own actions, including the
    // attendance relay above), but once written an entry's content can never
    // be changed or removed by anyone — including admins. A byte-for-byte
    // no-op re-set is still allowed since the client resyncs the whole
    // collection on every change (see isNoOpWrite()).
    match /audit_logs/{document=**} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update: if isNoOpWrite();
      allow delete: if false;
    }
  }
}
